[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
bottle = "*"
# mod-wsgi is not listed here because it only installs on systems with the
# Apache development files (for apxs), which breaks dependency resolution
# elsewhere, including Dependabot's. Production uses the system package
# libapache2-mod-wsgi-py3. admin/run-server needs it for its "normal" and
# "verbose" modes; to use those, run `pip install mod-wsgi` in the pipenv
# environment (on Ubuntu, install apache2-dev first).
python-decouple = "*"
python-daemon = "*"
configparser = "*"
arrow = "*"
yurl = "*"
topi = "*"
trinomial = "*"
boltons = "*"
bottle-fdsend = "*"
coif = "*"
commonpy = "*"
werkzeug = ">=3.1.9"
str2bool = "*"
humanize = "*"
expiringdict = "*"
lru-dict = "*"
plac = "*"
pokapi = "*"
requests = "*"
rich = "*"
sidetrack = "*"
peewee = "*"
pillow = "*"

[dev-packages]

[requires]
python_version = "3.12"
